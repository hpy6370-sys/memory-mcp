# Memory MCP Server Configuration

# Coreference resolution: comma-separated names for pronoun resolution
# Female names (她 → first name in list)
MEMORY_USER_NAMES=小红,红红
# Male names (他 → first name in list)
MEMORY_ASSISTANT_NAMES=小明,明明

# Entity graph: comma-separated known person names for entity extraction
MEMORY_KNOWN_PERSONS=小红,小明,红红,明明

# Gemini API key (for diary extraction)
# GEMINI_API_KEY=your-gemini-api-key

# Export directory for classification/cleanup reports (defaults to project root)
# MEMORY_EXPORT_DIR=/path/to/export

# Embedding model (optional, defaults to bge-small-zh-v1.5)
# EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
